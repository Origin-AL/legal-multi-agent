  {
    "reference_id": "cn-civil-code-509",
    "source_type": "statute",
    "title": "\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6c11\u6cd5\u5178 \u7b2c\u4e94\u767e\u96f6\u4e5d\u6761",
    "excerpt": "\u5f53\u4e8b\u4eba\u5e94\u5f53\u6309\u7167\u7ea6\u5b9a\u5168\u9762\u5c65\u884c\u81ea\u5df1\u7684\u4e49\u52a1\u3002",
    "body": "\u5408\u540c\u5f53\u4e8b\u4eba\u9700\u8981\u6309\u7167\u7ea6\u5b9a\u5168\u9762\u5c65\u884c\u4e49\u52a1\uff0c\u662f\u5408\u540c\u8d23\u4efb\u5206\u6790\u7684\u57fa\u7840\u6761\u6b3e\u3002",
    "tags": ["\u5408\u540c", "\u5c65\u884c", "\u6c11\u6cd5\u5178"]
  },
  {
    "reference_id": "cn-civil-code-577",
    "source_type": "statute",
    "title": "\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6c11\u6cd5\u5178 \u7b2c\u4e94\u767e\u4e03\u5341\u4e03\u6761",
    "excerpt": "\u5f53\u4e8b\u4eba\u4e00\u65b9\u4e0d\u5c65\u884c\u5408\u540c\u4e49\u52a1\u6216\u8005\u5c65\u884c\u4e0d\u7b26\u5408\u7ea6\u5b9a\u7684\uff0c\u5e94\u627f\u62c5\u8fdd\u7ea6\u8d23\u4efb\u3002",
    "body": "\u8be5\u6761\u4e3a\u8fdd\u7ea6\u8d23\u4efb\u57fa\u672c\u6761\u6b3e\uff0c\u53ef\u7528\u4e8e\u5206\u6790\u89e3\u9664\u6743\uff0c\u7ee7\u7eed\u5c65\u884c\uff0c\u635f\u5931\u8d54\u507f\u7b49\u95ee\u9898\u3002",
    "tags": ["\u5408\u540c", "\u8fdd\u7ea6", "\u8d23\u4efb"]
  },
  {
    "reference_id": "cn-civil-code-585",
    "source_type": "statute",
    "title": "\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6c11\u6cd5\u5178 \u7b2c\u4e94\u767e\u516b\u5341\u4e94\u6761",
    "excerpt": "\u7ea6\u5b9a\u8fdd\u7ea6\u91d1\u8fc7\u9ad8\u6216\u8fc7\u4f4e\u65f6\uff0c\u4eba\u6c11\u6cd5\u9662\u6216\u4ef2\u88c1\u673a\u6784\u53ef\u6839\u636e\u8bf7\u6c42\u8c03\u6574\u3002",
    "body": "\u5728\u5408\u540c\u8fdd\u7ea6\u91d1\u7ea6\u5b9a\u660e\u663e\u9ad8\u4e8e\u5b9e\u9645\u635f\u5931\u65f6\uff0c\u5b58\u5728\u88ab\u8c03\u51cf\u7684\u98ce\u9669\u3002",
    "tags": ["\u5408\u540c", "\u8fdd\u7ea6\u91d1", "\u8c03\u6574"]
  },
  {
    "reference_id": "sample-contract-dispute-view",
    "source_type": "judicial-interpretation",
    "title": "\u5408\u540c\u7ea0\u7eb7\u5ba1\u5224\u89c2\u70b9\u793a\u4f8b",
    "excerpt": "\u89e3\u9664\u6743\uff0c\u8fdd\u7ea6\u8d23\u4efb\u4e0e\u901a\u77e5\u4e49\u52a1\u7684\u5224\u65ad\u5e94\u7ed3\u5408\u5408\u540c\u6761\u6b3e\u3001\u5c65\u884c\u60c5\u51b5\u4e0e\u5b9e\u9645\u635f\u5931\u3002",
    "body": "\u5728\u5408\u540c\u89e3\u9664\u4e0e\u8fdd\u7ea6\u4e89\u8bae\u4e2d\uff0c\u9700\u7efc\u5408\u8003\u5bdf\u901a\u77e5\u8bb0\u5f55\uff0c\u8865\u6551\u671f\uff0c\u635f\u5931\u8bc1\u660e\u4e0e\u6761\u6b3e\u660e\u786e\u6027\u3002",
    "tags": ["\u89e3\u9664", "\u901a\u77e5", "\u5408\u540c\u7ea0\u7eb7"]
  },
  {
    "reference_id": "labor-contract-law-47",
    "source_type": "statute",
    "title": "\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u52b3\u52a8\u5408\u540c\u6cd5 \u7b2c\u56db\u5341\u4e03\u6761",
    "excerpt": "\u7ecf\u6d4e\u8865\u507f\u6309\u52b3\u52a8\u8005\u5728\u672c\u5355\u4f4d\u5de5\u4f5c\u5e74\u9650\u8ba1\u7b97\u3002",
    "body": "\u9002\u7528\u4e8e\u89e3\u9664\u52b3\u52a8\u5173\u7cfb\u65f6\u7684\u7ecf\u6d4e\u8865\u507f\u7b97\u6cd5\u5206\u6790\u3002",
    "tags": ["\u52b3\u52a8", "\u7ecf\u6d4e\u8865\u507f"]
  }
]
